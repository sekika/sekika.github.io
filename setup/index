#!/usr/bin/env python3
"""Generate the client-side search index for posts.

Run this script from any directory. It uses only Python's standard library,
so a commit does not require installing Python packages.
"""

from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import re
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
POST_NAME = re.compile(r"^(\d{4}-\d{2}-\d{2})-(.+)\.(md|markdown)$")
TAG = re.compile(r"<[^>]+>")
FRONT_MATTER = re.compile(r"\A---\s*\r?\n(.*?)\r?\n---\s*\r?\n", re.DOTALL)


def front_matter_value(front_matter: str, key: str) -> str | None:
    """Read the simple scalar values used by this site's post front matter."""
    match = re.search(rf"^{re.escape(key)}:\s*(.*?)\s*$", front_matter, re.MULTILINE)
    if not match:
        return None
    value = match.group(1).strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    return value or None


def timestamp(value: str | None, fallback: str) -> int:
    value = (value or fallback).replace("Z", "+00:00")
    value = re.sub(r"\s+([+-]\d{2})(\d{2})$", r"\1:\2", value)
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError:
        parsed = dt.datetime.fromisoformat(fallback)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=dt.timezone.utc)
    return int(parsed.timestamp())


def plain_text(markdown: str) -> str:
    """Keep searchable text while removing common Markdown and HTML markup."""
    markdown = re.sub(r"```[^\n]*", " ", markdown)
    markdown = re.sub(r"`([^`]*)`", r"\1", markdown)
    markdown = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", markdown)
    markdown = re.sub(r"!?(\[([^\]]*)\])\[[^\]]*\]", r"\2", markdown)
    markdown = TAG.sub(" ", markdown)
    markdown = re.sub(r"[*_~>#|]", " ", markdown)
    return " ".join(html.unescape(markdown).split())


def entry(post: Path) -> dict[str, object] | None:
    match = POST_NAME.match(post.name)
    if not match:
        return None
    content = post.read_text(encoding="utf-8")
    front_matter_match = FRONT_MATTER.match(content)
    front_matter = front_matter_match.group(1) if front_matter_match else ""
    body = content[front_matter_match.end():] if front_matter_match else content
    date = front_matter_value(front_matter, "date") or f"{match.group(1)} 00:00:00 +0000"
    updated = front_matter_value(front_matter, "update") or date
    title = front_matter_value(front_matter, "title") or match.group(2).replace("-", " ")
    return {
        "file": f"/{match.group(1).replace('-', '/')}/{match.group(2)}/",
        "title": title,
        "mtime": timestamp(updated, date),
        "ctime": timestamp(date, f"{match.group(1)} 00:00:00 +0000"),
        "body": f"{title} {plain_text(body)}",
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--posts-dir", type=Path, default=ROOT / "_posts")
    parser.add_argument("--output", type=Path, default=ROOT / "js" / "index.js")
    args = parser.parse_args()

    entries = [entry(post) for post in sorted(args.posts_dir.iterdir()) if post.is_file()]
    entries = [item for item in entries if item is not None]
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        "var start = new Date().getTime();\nvar data = "
        + json.dumps(entries, ensure_ascii=False, separators=(",", ":"))
        + ";\n",
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
