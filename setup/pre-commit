#!/bin/sh
# Install as .git/hooks/pre-commit (run: make -C setup).
# Rebuild and stage generated files whenever a post is part of the commit.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if git diff --cached --name-only --diff-filter=ACDMR -- _posts/ | grep -q .; then
  # setup/index reads the working tree. Refuse a mixed staged/unstaged post
  # change so the committed index never describes uncommitted content.
  if ! git diff --quiet -- _posts/; then
    echo "pre-commit: _posts/ に未ステージの変更があります。" >&2
    echo "pre-commit: 検索索引と本文を一致させるため、先にステージするか退避してください。" >&2
    exit 1
  fi

  # Refresh an existing update field in the front matter of committed posts.
  # Added posts and renames are included; deleted paths have no working file.
  updated_at=$(date -u "+%Y-%m-%d %H:%M:%S +0000")
  git diff --cached --name-only --diff-filter=ACMR -- _posts/ |
    while IFS= read -r post; do
      [ -f "$post" ] || continue
      if sed -n '1,/^---[[:space:]]*$/p' "$post" | grep -q '^update:'; then
        post_tmp="$post.pre-commit.$$"
        sed "/^---[[:space:]]*$/,/^---[[:space:]]*$/ { /^update:/c\\
update: $updated_at
}" "$post" > "$post_tmp"
        cat "$post_tmp" > "$post"
        rm -f "$post_tmp"
        git add -- "$post"
      fi
    done

  python3 "$repo_root/setup/index"
  git add js/index.js

  # Generate every currently missing static-article PDF, and refresh PDFs for
  # the posts included in this commit. The generator itself excludes articles
  # with pdf: false and interactive browser content.
  set -- $(git diff --cached --name-only --diff-filter=ACMR -- _posts/)
  if [ "$#" -gt 0 ]; then
    # node_modules may be shared across Linux and macOS workspaces. Rebuild the
    # native SQLite addon when opening an in-memory database cannot load it.
    if ! node -e 'const Database = require("./tools/minitype-pdf/node_modules/better-sqlite3"); const database = new Database(":memory:"); database.close();' >/dev/null 2>&1; then
      echo "pre-commit: better-sqlite3 をこの環境向けに再ビルドします。" >&2
      (cd "$repo_root/tools/minitype-pdf" && npm rebuild better-sqlite3)
    fi
    node "$repo_root/tools/minitype-pdf/generate-pdfs.mjs" --missing "$@"
    git add pdf/
  fi
fi
