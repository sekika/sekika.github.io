#!/usr/bin/env python3
"""A portable Docker runner for Codex, Claude Code, and Gemini CLI."""

import argparse
import base64
import configparser
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

CONFIG_PATH = Path.home() / ".config" / "agent" / "agent.ini"
EGRESS_CONFIG_DIR = Path.home() / ".config" / "agent"
EGRESS_ALLOWLIST_COMMON = EGRESS_CONFIG_DIR / "allowed_domains_common.txt"
EGRESS_ALLOWLISTS = {
    "codex": EGRESS_CONFIG_DIR / "allowed_domains_codex.txt",
    "claude": EGRESS_CONFIG_DIR / "allowed_domains_claude.txt",
}
EGRESS_ALLOWLIST_EFFECTIVE = EGRESS_CONFIG_DIR / ".allowed_domains_effective.txt"
EGRESS_DEFAULTS = {
    "codex": ["api.openai.com", "auth.openai.com", "chatgpt.com"],
    "claude": ["api.anthropic.com", "statsig.anthropic.com", "sentry.io"],
}
DEFAULTS = {
    "agent": "codex", "dockerfile": "./Dockerfile",
    "image": "agent:1.0", "container": "agent", "user": "agent",
    "workspace": "/workspace", "model": "", "effort": "",
}
AGENTS = {"cx": "codex", "codex": "codex", "cl": "claude", "claude": "claude",
          "gm": "gemini", "gemini": "gemini"}


def load_config() -> configparser.ConfigParser:
    cfg = configparser.ConfigParser()
    cfg["agent"] = DEFAULTS.copy()
    try:
        if CONFIG_PATH.exists():
            cfg.read(CONFIG_PATH, encoding="utf-8")
            if "workdir" in cfg["agent"]:
                del cfg["agent"]["workdir"]
                try:
                    lines = CONFIG_PATH.read_text(encoding="utf-8").splitlines(keepends=True)
                    new_lines = [line for line in lines if not line.strip().startswith("workdir")]
                    CONFIG_PATH.write_text("".join(new_lines), encoding="utf-8")
                except OSError:
                    pass
        else:
            # Keep creation separate from loading so a missing file is always
            # materialized with the same defaults used by the parser.
            CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
            save_config(cfg)
    except OSError as e:
        print(f"warning: could not create/read {CONFIG_PATH}: {e}", file=sys.stderr)
    return cfg


def save_config(cfg: configparser.ConfigParser) -> None:
    """Persist a config, including the built-in defaults."""
    with CONFIG_PATH.open("w", encoding="utf-8") as f:
        cfg.write(f)


def configured_model(cfg: configparser.SectionProxy, agent: str) -> str:
    """Return the model configured for an agent, with the common value as fallback."""
    models = cfg.parser["models"] if cfg.parser.has_section("models") else {}
    aliases = [k for k, v in AGENTS.items() if v == agent]
    for key in [agent, *aliases]:
        if key in models:
            return models[key]
    return cfg.get("model", "")


def configured_effort(cfg: configparser.SectionProxy, agent: str) -> str:
    """Return the effort configured for an agent, with the common value as fallback."""
    efforts = cfg.parser["efforts"] if cfg.parser.has_section("efforts") else {}
    aliases = [k for k, v in AGENTS.items() if v == agent]
    for key in [agent, *aliases]:
        if key in efforts:
            return efforts[key]
    return cfg.get("effort", "")


def docker(*args: str, check: bool = True, input: str | None = None) -> subprocess.CompletedProcess:
    kwargs = {"check": check}
    if input is not None:
        kwargs["input"] = input
        kwargs["text"] = True
    return subprocess.run(["docker", *args], **kwargs)


def ensure_docker() -> None:
    if shutil.which("docker") is None:
        raise SystemExit("error: docker command was not found")
    result = subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, text=True)
    if result.returncode:
        raise SystemExit("error: Docker is not running or is not reachable")


def image_exists(name: str) -> bool:
    return subprocess.run(["docker", "image", "inspect", name], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def build_image(args, no_cache: bool = False, pull: bool = False) -> None:
    dockerfile = Path(args.dockerfile).expanduser()
    if not dockerfile.is_file():
        raise SystemExit(f"error: dockerfile not found: {dockerfile}")
    cmd = ["build"]
    if no_cache:
        cmd.append("--no-cache")
    if pull:
        cmd.append("--pull")
    cmd += ["-f", str(dockerfile), "-t", args.image,
            str(Path(args.workdir).expanduser().resolve())]
    docker(*cmd)


UPDATE_DOCKERFILE_TEMPLATE = """\
FROM {base_image}

USER root
ENV HOME=/root

RUN apt-get update && apt-get upgrade -y && \
    apt-get autoremove -y && apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g --include=optional --ignore-scripts=false \
        @anthropic-ai/claude-code@latest \
        @openai/codex@latest \
        @google/gemini-cli@latest && \
    claude_package_dir="$(npm root -g)/@anthropic-ai/claude-code" && \
    node "$claude_package_dir/install.cjs" && \
    npm cache clean --force

USER {user}
ENV HOME=/home/{user}

# The endpoint may return a content-encoded script.  Ask curl to decode it
# before piping it to bash.
RUN curl --compressed -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir "$HOME/.local/bin"
"""


SQUID_CONFIG = """\
http_port 3128

acl CONNECT method CONNECT
acl SSL_ports port 443
acl Safe_ports port 443
acl allowed_domains dstdomain "/etc/squid/allowed_domains.txt"

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow CONNECT allowed_domains
http_access deny all

cache deny all
access_log stdio:/dev/stdout
cache_log /dev/stderr
pid_filename /run/squid.pid
coredump_dir /tmp
"""


def dockerfile_base_image(dockerfile: Path) -> str:
    """Return the image named by the first FROM instruction in dockerfile."""
    try:
        lines = dockerfile.read_text(encoding="utf-8").splitlines()
    except OSError as e:
        raise SystemExit(f"error: could not read dockerfile {dockerfile}: {e}")

    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if not parts or parts[0].upper() != "FROM":
            continue
        for part in parts[1:]:
            if not part.startswith("--"):
                if part.startswith("$"):
                    raise SystemExit(
                        f"error: variable-based FROM is not supported for egress proxy: {line}"
                    )
                return part
    raise SystemExit(f"error: no FROM instruction found in dockerfile: {dockerfile}")


def proxy_dockerfile(base_image: str) -> str:
    """Return the self-contained Dockerfile for the egress proxy."""
    squid_config = base64.b64encode(SQUID_CONFIG.encode("utf-8")).decode("ascii")
    return f"""\
FROM {base_image}

RUN apt-get update && apt-get install -y --no-install-recommends squid && \\
    rm -rf /var/lib/apt/lists/*

RUN echo {squid_config} | base64 -d > /etc/squid/squid.conf
USER proxy
EXPOSE 3128
"""


def update_image(args) -> None:
    if not image_exists(args.image):
        build_image(args)
        return
    dockerfile_content = UPDATE_DOCKERFILE_TEMPLATE.format(base_image=args.image, user=args.user)
    docker("build", "--no-cache", "-t", args.image, "-", input=dockerfile_content)


def mount(src: Path, dst: str) -> list[str]:
    return ["--mount", f"type=bind,source={src},destination={dst}"]


def image_name(args) -> str:
    return args.image


def container_exists(name: str) -> bool:
    return subprocess.run(["docker", "inspect", name], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def network_exists(name: str) -> bool:
    return subprocess.run(["docker", "network", "inspect", name], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def egress_names(args) -> tuple[str, str, str, str]:
    return (f"{args.container}-egress", f"{args.container}-isolated",
            f"{args.container}-uplink", "agent-egress:1.0")


def container_running(name: str) -> bool:
    """Return whether an existing container is currently running."""
    result = subprocess.run(["docker", "inspect", "-f", "{{.State.Running}}", name],
                            capture_output=True, text=True)
    return result.returncode == 0 and result.stdout.strip() == "true"


def normalized_domain(value: str) -> str:
    domain = value.strip().rstrip(".").lower()
    if not domain or len(domain) > 253 or "/" in domain or ":" in domain:
        raise SystemExit(f"error: invalid domain: {value}")
    labels = domain.split(".")
    if any(not label or len(label) > 63 or label.startswith("-") or label.endswith("-")
           or not all(c.isascii() and (c.isalnum() or c == "-") for c in label)
           for label in labels):
        raise SystemExit(f"error: invalid domain: {value}")
    return domain


def allowlist_path(agent: str) -> Path:
    try:
        return EGRESS_ALLOWLISTS[agent]
    except KeyError:
        raise SystemExit(f"error: egress allowlist is not supported for agent: {agent}")


def read_allowlist(path: Path) -> list[str]:
    domains = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.partition("#")[0].strip()
        if line:
            domains.append(normalized_domain(line))
    return sorted(set(domains))


def ensure_allowlists(agent: str) -> None:
    EGRESS_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not EGRESS_ALLOWLIST_COMMON.exists():
        EGRESS_ALLOWLIST_COMMON.write_text("", encoding="utf-8")
    path = allowlist_path(agent)
    if not path.exists():
        path.write_text(
            "".join(f"{domain}\n" for domain in EGRESS_DEFAULTS[agent]),
            encoding="utf-8",
        )


def load_allowlist(agent: str) -> list[str]:
    ensure_allowlists(agent)
    return sorted(set(read_allowlist(EGRESS_ALLOWLIST_COMMON) + read_allowlist(allowlist_path(agent))))


def write_effective_allowlist(agent: str) -> None:
    domains = load_allowlist(agent)
    if not domains:
        raise SystemExit(f"error: effective egress allowlist is empty for {agent}")
    EGRESS_ALLOWLIST_EFFECTIVE.write_text(
        "".join(f"{d}\n" for d in domains), encoding="utf-8"
    )


def write_allowlist(agent: str, domains: list[str]) -> None:
    allowlist_path(agent).write_text(
        "".join(f"{d}\n" for d in sorted(set(domains))), encoding="utf-8"
    )


def update_allowlist(args) -> None:
    ensure_allowlists(args.agent)
    domain = normalized_domain(args.domain)
    path = allowlist_path(args.agent)
    domains = set(read_allowlist(path))
    if args.command == "allow":
        domains.add(domain)
    else:
        domains.discard(domain)
    write_allowlist(args.agent, list(domains))
    proxy, _, _, _ = egress_names(args)
    if container_exists(proxy):
        docker("rm", "-f", proxy, check=False)
    print(f"{'allowed' if args.command == 'allow' else 'denied'} for {args.agent}: {domain}")


def proxy_image_base(image: str) -> str:
    result = subprocess.run(
        ["docker", "image", "inspect", "-f",
         '{{ index .Config.Labels "agent.egress.base-image" }}', image],
        capture_output=True, text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def ensure_egress(args) -> None:
    proxy, network, uplink, image = egress_names(args)
    ensure_allowlists(args.agent)
    write_effective_allowlist(args.agent)
    dockerfile = Path(args.dockerfile).expanduser()
    if not dockerfile.is_file():
        raise SystemExit(f"error: dockerfile not found: {dockerfile}")
    base_image = dockerfile_base_image(dockerfile)

    if not network_exists(network):
        docker("network", "create", "--internal", network)
    if not network_exists(uplink):
        docker("network", "create", uplink)
    if not image_exists(image) or proxy_image_base(image) != base_image:
        docker("build", "--label", f"agent.egress.base-image={base_image}",
               "-t", image, "-", input=proxy_dockerfile(base_image))

    # Recreate the proxy on each launch so the generated effective allowlist
    # and all hardening options always match the current runner.
    if container_exists(proxy):
        docker("rm", "-f", proxy)
    docker("run", "-d", "--name", proxy, "--network", uplink, "--user", "proxy",
           "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
           # Squid runs as Debian's unprivileged `proxy` user (UID/GID
           # 13).  Docker creates tmpfs mounts as root-owned by default,
           # which otherwise prevents Squid from creating /run/squid.pid.
           "--read-only", "--tmpfs", "/run:rw,noexec,nosuid,size=16m,uid=13,gid=13,mode=0755",
           "--tmpfs", "/tmp:rw,noexec,nosuid,size=16m",
           "--tmpfs", "/var/log/squid:rw,noexec,nosuid,size=16m",
           *mount(EGRESS_ALLOWLIST_EFFECTIVE, "/etc/squid/allowed_domains.txt"),
           "--entrypoint", "/usr/sbin/squid", image, "-N", "-f", "/etc/squid/squid.conf")
    if not container_running(proxy):
        raise SystemExit(
            f"error: egress proxy {proxy} exited during startup; inspect it with "
            f"`docker logs {proxy}`"
        )
    # The proxy gets a second interface on the private network. The agent gets
    # only this network, so clearing proxy variables cannot provide direct egress.
    docker("network", "connect", "--alias", "agent-egress", network, proxy)


def create_container(args) -> None:
    workdir = Path(args.workdir).expanduser().resolve()
    if not workdir.is_dir():
        raise SystemExit(f"error: workdir is not a directory: {workdir}")
    cmd = ["run", "--name", args.container, "-d"]
    if args.agent in ("codex", "claude") and not args.direct_egress:
        _, network, _, _ = egress_names(args)
        cmd += ["--network", network, f"--network-alias=agent-{args.agent}",
                "-e", "HTTP_PROXY=http://agent-egress:3128",
                "-e", "HTTPS_PROXY=http://agent-egress:3128",
                "-e", "ALL_PROXY=http://agent-egress:3128",
                "-e", "NO_PROXY=localhost,127.0.0.1"]
    cmd += mount(workdir, args.workspace)
    guest_home = Path(f"/home/{args.user}")
    if args.agent == "codex":
        state = Path.home() / ".codex"
        state.mkdir(parents=True, exist_ok=True)
        cmd += mount(state, str(guest_home / ".codex"))
    elif args.agent == "claude":
        state = Path.home() / ".claude"
        if not state.is_dir():
            raise SystemExit(f"error: state directory does not exist: {state}")
        cmd += mount(state, str(guest_home / ".claude"))
    else:
        state = Path.home() / ".gemini"
        keyring = Path.home() / ".local" / "share" / "keyrings"
        state.mkdir(parents=True, exist_ok=True)
        keyring.mkdir(parents=True, exist_ok=True)
        cmd += mount(state, str(guest_home / ".gemini"))
        cmd += mount(keyring, str(guest_home / ".local/share/keyrings"))
        cmd += ["--network=host"]
    cmd += ["-e", "TERM=xterm-256color", "-e", "LANG=ja_JP.UTF-8", image_name(args),
            "tail", "-f", "/dev/null"]
    docker(*cmd)


def ensure_container(args) -> None:
    # Bind mounts are fixed at creation time; recreate every launch so -d and
    # the authentication mounts always match the dedicated cx/cl/gm runners.
    if container_exists(args.container):
        docker("rm", "-f", args.container, check=False)
    create_container(args)


def cli_command(args, extra: list[str]) -> list[str]:
    # Keep the Antigravity entry point identical to the dedicated gm runner.
    # `agy` is installed in ~/.local/bin by the image and is the command used
    # by gm; invoking Gemini CLI directly uses a different trust/config path.
    command = {
        "codex": "codex",
        "claude": "claude",
        "gemini": f"/home/{args.user}/.local/bin/agy",
    }[args.agent]
    result = [command]
    if args.model:
        result += ["--model", args.model]
    if args.effort:
        if args.agent == "codex":
            result += ["-c", f"model_reasoning_effort={args.effort}"]
        elif args.agent == "claude":
            result += ["--effort", args.effort]
        elif args.agent == "gemini":
            if args.effort not in ("low", "medium", "high"):
                raise SystemExit(f"error: gemini effort must be one of low, medium, high (got: {args.effort})")
            result += ["--effort", args.effort]
    return result + extra


def terminal_size() -> tuple[int, int]:
    try:
        columns, rows = os.get_terminal_size()
    except OSError:
        columns, rows = 80, 24
    # Antigravity prints a copyable OAuth URL on one line.
    return max(columns, 1000), rows


CODEX_OVERRIDES = ["sandbox_mode=danger-full-access", "notify=[]", "mcp_servers.node_repl.enabled=false"]
CODEX_OVERRIDES += [f"plugins.{chr(34)}{name}{chr(34)}.enabled=false" for name in ("visualize@openai-bundled", "documents@openai-primary-runtime", "pdf@openai-primary-runtime", "spreadsheets@openai-primary-runtime", "presentations@openai-primary-runtime", "template-creator@openai-primary-runtime", "browser@openai-bundled", "codex-app-tools@openai-bundled", "unified-computer-use@openai-bundled", "computer-use@openai-bundled", "sites@openai-bundled")]
def run_codex(args):
    columns, rows = terminal_size()
    codex_args = cli_command(args, args.args)
    options = []
    for override in CODEX_OVERRIDES:
        options += ["-c", override]
    codex_args[1:1] = options
    command = f"cd {shlex.quote(args.workspace)} && exec {shlex.join(codex_args)}"
    docker(
        "exec", "-it", "-u", args.user,
        "-e", f"HOME=/home/{args.user}",
        "-e", "LANG=ja_JP.UTF-8", "-e", "TERM=xterm-256color",
        "-e", f"COLUMNS={columns}", "-e", f"LINES={rows}",
        args.container, "/bin/bash", "-lc", command,
    )
def main() -> None:
    cfg = load_config()["agent"]
    p = argparse.ArgumentParser(description="Run coding agents in Docker.")
    p.add_argument("--agent", "-a", choices=sorted(AGENTS), default=cfg.get("agent"))
    p.add_argument("-d", "--dir", dest="workdir")
    p.add_argument("--dockerfile", default=cfg.get("dockerfile"))
    p.add_argument("--image")
    p.add_argument("--container")
    p.add_argument("--user", default=cfg.get("user"))
    p.add_argument("--workspace")
    # Keep None here so an explicit CLI value can be distinguished from config.
    p.add_argument("-m", "--model")
    p.add_argument("--effort", choices=["low", "medium", "high", "xhigh"])
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--direct-egress", action="store_true",
                   help="allow Codex/Claude to use Docker's direct network instead of the Squid egress proxy")
    p.add_argument("-u", "--update", action="store_true", help="update packages and CLIs in container image before starting the agent")
    p.add_argument("command", nargs="?", choices=["run", "build", "rebuild", "update", "start", "stop", "rm", "shell", "exec", "images", "allow", "deny", "domains"], default="run")
    p.add_argument("args", nargs=argparse.REMAINDER)
    args = p.parse_args()
    args.agent = AGENTS[args.agent]
    if args.model is None:
        args.model = configured_model(cfg, args.agent)
    if args.effort is None:
        args.effort = configured_effort(cfg, args.agent)
    if args.effort and args.effort not in ("low", "medium", "high", "xhigh"):
        raise SystemExit(f"error: invalid effort '{args.effort}': must be one of low, medium, high, xhigh")
    args.workdir = args.workdir or os.getcwd()
    args.image = args.image or cfg.get("image")
    args.container = args.container or cfg.get("container")
    args.workspace = args.workspace or cfg.get("workspace")
    dash_dash_idx = args.args.index("--") if "--" in args.args else len(args.args)
    pre_args = args.args[:dash_dash_idx]
    post_args = args.args[dash_dash_idx:]
    if "--dry-run" in pre_args:
        args.dry_run = True
        pre_args.remove("--dry-run")
    if "-u" in pre_args:
        args.update = True
        pre_args.remove("-u")
    if "--update" in pre_args:
        args.update = True
        pre_args.remove("--update")
    if "--direct-egress" in pre_args:
        args.direct_egress = True
        pre_args.remove("--direct-egress")
    args.args = pre_args + post_args
    if args.args[:1] == ["--"]:
        args.args.pop(0)
    if args.dry_run:
        print("dry-run: ", " ".join(shlex.quote(x) for x in sys.argv))
        return
    if args.command in ("allow", "deny"):
        if len(args.args) != 1:
            raise SystemExit(f"error: {args.command} requires exactly one domain")
        args.domain = args.args[0]
        update_allowlist(args)
        return
    if args.command == "domains":
        print("\n".join(load_allowlist(args.agent)))
        return
    ensure_docker()
    if args.command == "images":
        docker("images"); return
    if args.command == "build":
        build_image(args, no_cache=False, pull=False)
        return
    if args.command == "rebuild":
        build_image(args, no_cache=True, pull=True)
        return
    if args.command == "update":
        update_image(args)
        return
    if args.update:
        update_image(args)
    if args.command == "stop":
        proxy, _, _, _ = egress_names(args)
        docker("stop", args.container, check=False)
        docker("stop", proxy, check=False)
        return
    if args.command == "rm":
        proxy, network, uplink, _ = egress_names(args)
        docker("rm", "-f", args.container, check=False)
        docker("rm", "-f", proxy, check=False)
        docker("network", "rm", network, check=False)
        docker("network", "rm", uplink, check=False)
        return
    if not image_exists(args.image):
        build_image(args)
    if args.agent in ("codex", "claude") and not args.direct_egress:
        ensure_egress(args)
    ensure_container(args)
    if args.command == "start": return
    if args.command == "shell":
        docker("exec", "-it", "-u", args.user, "-w", args.workspace, args.container, "/bin/bash"); return
    if args.command == "exec":
        if not args.args: raise SystemExit("error: exec requires a command")
        docker("exec", "-it", "-u", args.user, "-w", args.workspace, args.container, *args.args); return
    environment = ["-e", "LANG=ja_JP.UTF-8", "-e", "TERM=xterm-256color"]
    if args.agent == "claude":
        environment += ["-e", f"CLAUDE_CONFIG_DIR=/home/{args.user}/.claude"]
    if args.agent == "gemini":
        columns, rows = terminal_size()
        gemini_args = cli_command(args, args.args)[1:]
        shell_command = (
            'eval "$(gnome-keyring-daemon --start --components=secrets)"; '
            f"cd {shlex.quote(args.workspace)} && exec {shlex.quote(cli_command(args, [])[0])} \"$@\""
        )
        docker("exec", "-it", "-u", args.user, *environment,
               "-e", f"COLUMNS={columns}", "-e", f"LINES={rows}",
               args.container, "dbus-run-session", "--", "/bin/bash", "-lc",
               shell_command, "agy", *gemini_args)
        return
    if args.agent == "codex":
        run_codex(args)
        return
    docker("exec", "-it", "-u", args.user, *environment, "-w", args.workspace,
           args.container, *cli_command(args, args.args))


if __name__ == "__main__":
    main()
